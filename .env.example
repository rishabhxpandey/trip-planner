# Postgres. Supabase: use the "Transaction pooler" string (port 6543) from Connect in the dashboard.
# A Neon URL (*.neon.tech) uses the neon-http driver; anything else uses postgres-js.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Auth.js. Generate a secret with `npx auth secret`.
AUTH_SECRET=
# Optional. Without these, Google sign-in buttons explain it isn't set up.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional. Agent API rate limit (30 req/min per token). Falls back to in-memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Config knobs
NEXT_PUBLIC_WEEK_STARTS_MONDAY=false
NEXT_PUBLIC_MIN_RANGE_DAYS=2
NEXT_PUBLIC_PUBLIC_VETOES=true
