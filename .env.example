# Postgres. A Neon URL (*.neon.tech) uses the neon-http driver; anything else uses postgres-js (local dev).
DATABASE_URL=postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/outward?sslmode=require

# Auth.js. Generate a secret with `npx auth secret`.
AUTH_SECRET=
# Optional. Without these, Google sign-in buttons explain it isn't set up.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional. Agent API rate limit (30 req/min per token). Falls back to in-memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Config knobs
NEXT_PUBLIC_WEEK_STARTS_MONDAY=false
NEXT_PUBLIC_MIN_RANGE_DAYS=2
NEXT_PUBLIC_PUBLIC_VETOES=true
